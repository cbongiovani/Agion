{
  "name": "Avaliacao",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da avalia\u00e7\u00e3o"
    },
    "periodo": {
      "type": "string",
      "enum": [
        "AT1",
        "AT2",
        "AT3",
        "AT4"
      ],
      "description": "Per\u00edodo da avalia\u00e7\u00e3o (AT1=Mar\u00e7o, AT2=Junho, AT3=Setembro, AT4=Dezembro)"
    },
    "ano": {
      "type": "number",
      "description": "Ano da avalia\u00e7\u00e3o"
    },
    "analista_id": {
      "type": "string",
      "description": "ID do analista que far\u00e1 a avalia\u00e7\u00e3o"
    },
    "questoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array com IDs das 20 quest\u00f5es selecionadas"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio da avalia\u00e7\u00e3o"
    },
    "data_fim": {
      "type": "string",
      "format": "date-time",
      "description": "Data limite para conclus\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Andamento",
        "Conclu\u00edda"
      ],
      "default": "Pendente",
      "description": "Status da avalia\u00e7\u00e3o"
    },
    "nota": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Nota final (0-10)"
    },
    "criado_por": {
      "type": "string",
      "description": "Email de quem criou a avalia\u00e7\u00e3o"
    }
  },
  "required": [
    "titulo",
    "periodo",
    "ano",
    "analista_id",
    "questoes"
  ]
}