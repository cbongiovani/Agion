{
  "name": "SolicitacaoFuncao",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que solicitou"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "funcao_atual": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o atual do usu\u00e1rio"
    },
    "funcao_solicitada": {
      "type": "string",
      "enum": [
        "supervisor",
        "admin"
      ],
      "description": "Fun\u00e7\u00e3o solicitada"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa da solicita\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "rejeitada"
      ],
      "default": "pendente",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "data_resposta": {
      "type": "string",
      "format": "date-time",
      "description": "Data da resposta"
    },
    "respondido_por": {
      "type": "string",
      "description": "Email de quem respondeu"
    }
  },
  "required": [
    "usuario_id",
    "usuario_nome",
    "usuario_email",
    "funcao_atual",
    "funcao_solicitada"
  ]
}