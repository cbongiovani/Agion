{
  "name": "Role",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identificador \u00fanico da fun\u00e7\u00e3o (ex: 'admin', 'supervisor', 'analista')",
      "index": true
    },
    "label": {
      "type": "string",
      "description": "Nome leg\u00edvel da fun\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da fun\u00e7\u00e3o"
    },
    "badge_color": {
      "type": "string",
      "default": "gray",
      "description": "Cor do badge na UI (ex: 'blue', 'green', 'red', 'purple')"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 uma fun\u00e7\u00e3o do sistema (n\u00e3o pode ser deletada)"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o na UI"
    }
  },
  "required": [
    "key",
    "label"
  ],
  "indexes": [
    {
      "fields": [
        "key"
      ]
    }
  ]
}