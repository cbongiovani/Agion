{
  "name": "AprovacaoAtividade",
  "type": "object",
  "properties": {
    "atividade_id": {
      "type": "string",
      "description": "ID da atividade a ser aprovada",
      "index": true
    },
    "tipo": {
      "type": "string",
      "enum": [
        "atividade",
        "fechamento",
        "warroom",
        "quizz",
        "questao",
        "avaliacao"
      ],
      "description": "Tipo do registro para aprova\u00e7\u00e3o",
      "index": true
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status da aprova\u00e7\u00e3o",
      "index": true
    },
    "motivo_rejeicao": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o (se aplic\u00e1vel)"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Email do coordenador que aprovou"
    },
    "data_aprovacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da aprova\u00e7\u00e3o"
    },
    "ack_by_owner": {
      "type": "boolean",
      "default": false,
      "description": "Se o propriet\u00e1rio reconheceu a aprova\u00e7\u00e3o/rejei\u00e7\u00e3o",
      "index": true
    },
    "ack_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data do reconhecimento"
    },
    "ack_by": {
      "type": "string",
      "description": "Email de quem reconheceu"
    }
  },
  "required": [
    "atividade_id",
    "tipo"
  ],
  "indexes": [
    {
      "fields": [
        "atividade_id"
      ]
    },
    {
      "fields": [
        "tipo"
      ]
    },
    {
      "fields": [
        "status"
      ]
    },
    {
      "fields": [
        "tipo",
        "status"
      ]
    },
    {
      "fields": [
        "ack_by_owner"
      ]
    },
    {
      "fields": [
        "atividade_id",
        "tipo"
      ]
    }
  ]
}