{
  "name": "OKR",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do OKR"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Qualidade",
        "Efici\u00eancia",
        "Cobertura",
        "Satisfa\u00e7\u00e3o",
        "Desenvolvimento"
      ],
      "description": "Categoria do OKR"
    },
    "meta_valor": {
      "type": "number",
      "description": "Valor meta a atingir"
    },
    "valor_atual": {
      "type": "number",
      "description": "Valor atual"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida (%, pontos, etc)"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino"
    },
    "status": {
      "type": "string",
      "enum": [
        "Em Progresso",
        "No Alvo",
        "Risco",
        "Conclu\u00eddo"
      ],
      "default": "Em Progresso"
    },
    "atribuido_a": {
      "type": "string",
      "description": "Email do supervisor/coordenador respons\u00e1vel"
    }
  },
  "required": [
    "nome",
    "categoria",
    "meta_valor",
    "valor_atual",
    "unidade"
  ]
}