{
  "name": "Questao",
  "type": "object",
  "properties": {
    "enunciado": {
      "type": "string",
      "description": "Enunciado da quest\u00e3o"
    },
    "alternativa_a": {
      "type": "string",
      "description": "Alternativa A"
    },
    "alternativa_b": {
      "type": "string",
      "description": "Alternativa B"
    },
    "alternativa_c": {
      "type": "string",
      "description": "Alternativa C"
    },
    "alternativa_d": {
      "type": "string",
      "description": "Alternativa D"
    },
    "resposta_correta": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Alternativa correta"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da quest\u00e3o (ex: Sistema Operacional, Hardware, Rede)"
    },
    "dificuldade": {
      "type": "string",
      "enum": [
        "F\u00e1cil",
        "M\u00e9dia",
        "Dif\u00edcil"
      ],
      "default": "M\u00e9dia",
      "description": "N\u00edvel de dificuldade"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aprovada",
        "Pendente",
        "Recusada"
      ],
      "default": "Pendente",
      "description": "Status da quest\u00e3o"
    },
    "criado_por": {
      "type": "string",
      "description": "Email de quem criou a quest\u00e3o"
    },
    "fonte": {
      "type": "string",
      "description": "Fonte ou refer\u00eancia da quest\u00e3o"
    }
  },
  "required": [
    "enunciado",
    "alternativa_a",
    "alternativa_b",
    "alternativa_c",
    "alternativa_d",
    "resposta_correta"
  ]
}