{
  "name": "RespostaAvaliacao",
  "type": "object",
  "properties": {
    "avaliacao_id": {
      "type": "string",
      "description": "ID da avalia\u00e7\u00e3o"
    },
    "analista_id": {
      "type": "string",
      "description": "ID do analista"
    },
    "questao_id": {
      "type": "string",
      "description": "ID da quest\u00e3o"
    },
    "resposta_selecionada": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Alternativa selecionada pelo analista"
    },
    "correta": {
      "type": "boolean",
      "description": "Se a resposta est\u00e1 correta"
    },
    "tempo_resposta_segundos": {
      "type": "number",
      "description": "Tempo gasto para responder (em segundos)"
    }
  },
  "required": [
    "avaliacao_id",
    "analista_id",
    "questao_id",
    "resposta_selecionada",
    "correta"
  ]
