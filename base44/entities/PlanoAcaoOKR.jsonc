{
  "name": "PlanoAcaoOKR",
  "type": "object",
  "properties": {
    "okr_id": {
      "type": "string",
      "description": "ID do OKR relacionado",
      "index": true
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do plano de a\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da a\u00e7\u00e3o"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Cr\u00edtica",
        "Alta",
        "M\u00e9dia",
        "Baixa"
      ],
      "default": "M\u00e9dia"
    },
    "analise_ia": {
      "type": "string",
      "description": "An\u00e1lise gerada pela IA"
    },
    "passos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Passos para executar"
    },
    "responsavel": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planejado",
        "Em Execu\u00e7\u00e3o",
        "Conclu\u00eddo",
        "Parado"
      ],
      "default": "Planejado"
    },
    "data_criacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de cria\u00e7\u00e3o"
    },
    "gerado_por_ia": {
      "type": "boolean",
      "default": true,
      "description": "Se foi gerado automaticamente pela IA"
    }
  },
  "required": [
    "okr_id",
    "titulo",
    "descricao",
    "prioridade"
  ]
}