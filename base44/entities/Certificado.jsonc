{
  "name": "Certificado",
  "type": "object",
  "properties": {
    "nome_curso": {
      "type": "string",
      "description": "Nome do curso ou certifica\u00e7\u00e3o"
    },
    "analista_id": {
      "type": "string",
      "description": "ID do analista"
    },
    "analista_nome": {
      "type": "string",
      "description": "Nome do analista"
    },
    "supervisor_id": {
      "type": "string",
      "description": "ID do supervisor"
    },
    "supervisor_nome": {
      "type": "string",
      "description": "Nome do supervisor"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date",
      "description": "Data de conclus\u00e3o do curso"
    },
    "certificado_url": {
      "type": "string",
      "description": "URL do arquivo de certificado"
    },
    "registrado_por": {
      "type": "string",
      "description": "Email de quem registrou o certificado"
    }
  },
  "required": [
    "nome_curso",
    "analista_id",
    "supervisor_id",
    "data_conclusao",
    "certificado_url"
  ]
}