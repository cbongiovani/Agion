{
  "name": "FuncaoUsuario",
  "type": "object",
  "properties": {
    "nome_funcao": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o (ex: supervisor, noc, etc)"
    },
    "label_exibicao": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o da fun\u00e7\u00e3o (ex: Supervisor, NOC, etc)"
    },
    "cor_badge": {
      "type": "string",
      "description": "Cor do badge no formato TailwindCSS"
    },
    "criado_por": {
      "type": "string",
      "description": "Email de quem criou a fun\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a fun\u00e7\u00e3o est\u00e1 ativa no sistema"
    }
  },
  "required": [
    "nome_funcao",
    "label_exibicao"
  ]
}