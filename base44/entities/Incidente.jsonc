{
  "name": "Incidente",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do incidente"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do incidente"
    },
    "severidade": {
      "type": "string",
      "enum": [
        "Cr\u00edtica",
        "Alta",
        "M\u00e9dia",
        "Baixa"
      ],
      "default": "M\u00e9dia",
      "description": "N\u00edvel de severidade do incidente",
      "index": true
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Infraestrutura",
        "Aplica\u00e7\u00e3o",
        "Rede",
        "Seguran\u00e7a",
        "Banco de Dados",
        "Servi\u00e7o"
      ],
      "default": "Infraestrutura",
      "description": "Categoria do incidente"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em An\u00e1lise",
        "Em Progresso",
        "Aguardando Terceiros",
        "Resolvido",
        "Fechado"
      ],
      "default": "Aberto",
      "description": "Status atual do incidente",
      "index": true
    },
    "supervisor_id": {
      "type": "string",
      "description": "ID do supervisor que registrou o incidente"
    },
    "unidade_afetada": {
      "type": "string",
      "description": "Unidade ou departamento afetado pelo incidente"
    },
    "atividades": {
      "type": "array",
      "description": "Linha do tempo de atividades realizadas",
      "items": {
        "type": "object",
        "properties": {
          "hora": {
            "type": "string",
            "description": "Hora da atividade"
          },
          "acao": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o da a\u00e7\u00e3o realizada"
          },
          "setor": {
            "type": "string",
            "enum": [
              "Suporte",
              "Redes",
              "NOC",
              "Seguran\u00e7a",
              "Sistemas",
              "DevOps",
              "Gest\u00e3o",
              "Fornecedor/Terceiro",
              "Outro"
            ],
            "description": "Setor respons\u00e1vel pela a\u00e7\u00e3o"
          }
        }
      }
    },
    "impacto": {
      "type": "string",
      "description": "Impacto nos servi\u00e7os e usu\u00e1rios"
    },
    "acoes_tomadas": {
      "type": "string",
      "description": "A\u00e7\u00f5es j\u00e1 realizadas para resolu\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do respons\u00e1vel pelo incidente"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de in\u00edcio do incidente"
    },
    "data_resolucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de resolu\u00e7\u00e3o do incidente"
    },
    "registrado_por": {
      "type": "string",
      "description": "Email de quem registrou o incidente"
    }
  },
  "required": [
    "titulo",
    "descricao",
    "severidade",
    "categoria",
    "status",
    "data_inicio"
  ],
  "indexes": [
    {
      "fields": [
        "severidade"
      ]
    },
    {
      "fields": [
        "status"
      ]
    }
  ]
}